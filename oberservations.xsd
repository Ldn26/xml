
<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:complexType name="LieuDescriptionType">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="position">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="X" type="xs:integer"/>
                        <xs:element name="Y" type="xs:integer"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
    </xs:complexType>

    <xs:complexType name="LieuReferenceType">
        <xs:attribute name="ref" type="xs:IDREF" use="required"/>
    </xs:complexType>






<xs:complexType  name="espece">

<xs:sequence>
<xs:element name="id" type="xs:positiveInteger"/>
<xs:element name="lieu" type="xs:gYear"/>
<xs:element name="YEAR" type="xs:gYear"/>

</xs:sequence>

</complexType >





    <xs:complexType name="EspeceDescriptionType">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="description" type="xs:string"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
    </xs:complexType>

    <!-- Type pour référencer une espèce -->
    <xs:complexType name="EspeceReferenceType">
        <xs:attribute name="ref" type="xs:IDREF" use="required"/>
    </xs:complexType>

    <!-- Type d'une observation -->
    <xs:complexType name="ObservationType">
        <xs:sequence>
            <xs:element name="id" type="xs:positiveInteger"/>
            <xs:element name="YEAR" type="xs:gYear"/>
            <xs:element name="lieu" type="LieuReferenceType"/>
            <xs:element name="espece" type="EspeceReferenceType"/>
            <xs:element name="NBR" type="xs:nonNegativeInteger"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="observations">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="lieux">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="lieu"
                                        type="LieuDescriptionType"
                                        maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="especes">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="espece"
                                        type="EspeceDescriptionType"
                                        maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="observation"
                            type="ObservationType"
                            maxOccurs="unbounded"/>

            </xs:sequence>
        </xs:complexType>

        <xs:unique name="identifiantObservationUnique">
            <xs:selector xpath="observation"/>
            <xs:field xpath="id"/>
        </xs:unique>
    </xs:element>

</xs:schema>
