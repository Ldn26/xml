
<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- regles pour  lieu -->
    <xs:complexType name="lieu_type">
        <xs:sequence>
            <xs:element name="id" type="xs:positiveInteger"/>
            <xs:element name="nom" type="xs:string"/>

            <xs:element name="position">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="X" type="xs:integer"/>
                        <xs:element name="Y" type="xs:integer"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- regle pour  espèce -->
    <xs:complexType name="espece_type">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="id" type="xs:positiveInteger"/>
            <xs:element name="description" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- regle pour  les observation -->
    <xs:complexType name="observation_type">
        <xs:sequence>
            <xs:element name="id" type="xs:positiveInteger"/>
            <xs:element name="YEAR" type="xs:gYear"/>
            <xs:element name="lieu" type="lieu_type"/>
            <xs:element name="espece" type="espece_type"/>
            <xs:element name="NBR" type="xs:nonNegativeInteger"/>
        </xs:sequence>
    </xs:complexType>

    <!-- main    rule -->
    <xs:element name="observations">
        <xs:complexType>
            <xs:sequence>
                <xs:element
                    name="observation"
                    type="observation_type"
                    minOccurs="1"
                    maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>

        <xs:unique name="id_observation_unique">
    <!--  appliquer poue les observ dans le chmp id     -->
            <xs:selector xpath="observation"/>
            <xs:field xpath="id"/>
        </xs:unique>
    </xs:element>

</xs:schema>
